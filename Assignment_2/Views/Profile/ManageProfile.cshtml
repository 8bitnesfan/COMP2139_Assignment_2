@model Assignment_1.Models.ManageProfileViewModel
@{
    ViewData["Title"] = "Manage Profile";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="UpdateProfile" method="post">
    <div class="form-group">
        <label asp-for="FullName" class="control-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ContactInfo" class="control-label"></label>
        <input asp-for="ContactInfo" class="form-control" />
        <span asp-validation-for="ContactInfo" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PreferredCategories" class="control-label"></label>
        <input asp-for="PreferredCategories" class="form-control" />
        <span asp-validation-for="PreferredCategories" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>